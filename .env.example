# HousePro — environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# Find them in your Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Em projetos novos, o Supabase mostra a chave como 'publishable' — também é aceite:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL público onde o site corre (canónicos + tags de partilha). Em estágio,
# aponta ao ...vercel.app ou a um subdomínio (ex.: beta.housepro.pt) — NÃO ao
# domínio principal enquanto ele servir o site antigo. Se ausente, cai em
# https://www.housepro.pt.
# NEXT_PUBLIC_SITE_URL=https://housepro-xxxx.vercel.app

# Server-only key for privileged operations (never expose to the browser).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Notificações de lead (opcional) --------------------------------------
# Ativa o(s) canal(is) para avisar o consultor quando entra uma lead.
# Webhook genérico (Slack/Zapier/Make/n8n) — recebe { text, lead, context }.
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Email via Resend (https://resend.com):
# RESEND_API_KEY=re_xxx
# LEAD_FROM_EMAIL=leads@housepro.pt
# LEAD_NOTIFY_EMAIL=comercial@housepro.pt

# --- Importar fotos do Google Drive (opcional) ----------------------------
# Permite ao consultor colar o link de uma PASTA partilhada do Drive (as fotos
# do fotógrafo) e importar tudo de uma vez. Precisa de uma API key do Google
# com a "Google Drive API" ativada (Google Cloud Console → APIs & Services).
# A pasta/ficheiros têm de estar partilhados como "qualquer pessoa com o link".
# GOOGLE_DRIVE_API_KEY=AIza...

# --- Facebook / Instagram Lead Ads (opcional) -----------------------------
# Webhook: /api/webhooks/facebook-leads
# FB_VERIFY_TOKEN=um-token-secreto-que-defines-na-meta
# FB_PAGE_TOKEN=token-da-pagina-para-ler-os-dados-da-lead

# --- Módulo Meta CRM (Facebook/Instagram Lead Ads) ------------------------
# SÓ server-side — NUNCA com prefixo NEXT_PUBLIC_ (não pode ir para o browser).
# Sem estas variáveis o módulo corre em modo demonstração (mocks) e o webhook
# não processa eventos como reais. O fluxo demo usa /api/meta/mock-lead.
# Webhook do módulo: /api/meta/webhook  (GET verifica, POST recebe com HMAC).
#
# Segredo da app (assinatura HMAC dos webhooks — X-Hub-Signature-256):
# META_APP_SECRET=xxxxxxxxxxxxxxxx
# Token de verificação da subscrição do webhook (handshake GET):
# META_VERIFY_TOKEN=um-token-secreto-que-defines-na-meta
# Token de acesso à Página (ler os dados da lead via Graph API):
# META_PAGE_TOKEN=token-da-pagina
# Opcional — token por referência (meta_connections.token_ref="page:123"
# resolve para META_PAGE_TOKEN__PAGE_123), para várias páginas:
# META_PAGE_TOKEN__PAGE_123=token-da-pagina-123
