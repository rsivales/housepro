        "featuresRooms"
      ]
    },
    {
      "required": [
        "featuresBedroomNumber"
      ]
    }
  ],
  "properties": {
    "featuresType": {
      "title": "property types",
      "description": "Types availability varies between countries. Spain: rustic_rural, rustic_masia, rustic_cortijo, rustic_terrera, rustic_torre, rustic_caseron. Italy: house_villa, rustic_masseria, rustic_trullo, rustic_casalecascina, rustic_baita. Portugal: house_andar_moradia, rustic_quinta, rustic_moinho, rustic_montealentejano, rustic_solar. Spain and Portugal: rustic_palace. France: house_semidetached, house_independent, house_terraced, rustic_basque_house, rustic_contemporary_house, rustic_design_house, rustic_master_house, rustic_traditional_house, rustic_manor, rustic_riad, rustic_mazet, rustic_montain_chalet, rustic_vineyard_domain, rustic_farm, rustic_stone_house. The rest of the types is available in every country.",
      "enum": [
        "flat",
        "house",
        "house_andar_moradia",
        "house_independent",
        "house_semidetached",
        "house_terraced",
        "house_villa",
        "rustic",
        "rustic_house",
        "rustic_village",
        "rustic_castle",
        "rustic_palace",
        "rustic_baita",
        "rustic_basque_house",
        "rustic_contemporary_house",
        "rustic_design_house",
        "rustic_farm",
        "rustic_manor",
        "rustic_master_house",
        "rustic_mazet",
        "rustic_montain_chalet",
        "rustic_montealentejano",
        "rustic_moinho",
        "rustic_quinta",
        "rustic_riad",
        "rustic_rural",
        "rustic_casalecascina",
        "rustic_caseron",
        "rustic_cortijo",
        "rustic_masia",
        "rustic_masseria",
        "rustic_solar",
        "rustic_stone_house",
        "rustic_terrera",
        "rustic_torre",
        "rustic_traditional_house",
        "rustic_trullo",
        "rustic_vineyard_domain"
      ]
    },
