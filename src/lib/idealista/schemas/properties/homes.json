{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://feeds.idealista.com/v6/schemas/properties/homes.json",
  "title": "Homes Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "featuresType",
    "featuresAreaConstructed",
    "featuresBathroomNumber"
  ],
